---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SkylineArt from '../components/SkylineArt.astro';
import Txt from '../components/Txt.astro';
import site from '../../content/site.json';
import projects from '../../content/projects.json';
import { skyline, totalCommits, tallest } from '../lib/skyline';

const titleOf = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
const featured = projects.filter((p) => p.mission);
const more = projects.filter((p) => !p.mission);
const commitsOf = (repo: string | null) => skyline.repos.find((r) => r.name === repo)?.commits;
const { contact } = site;
---

<Base>
  <main id="main">
    <Hero />

    <section class="about" id="about" aria-labelledby="about-title">
      <div class="wrap about__grid">
        <div class="about__text">
          <p class="caption">{site.about.caption}</p>
          <h2 id="about-title" class="section-title">About me</h2>
          <p class="about__lead">{site.about.lead}</p>
          {site.about.paragraphs.map((text) => <p><Txt text={text} /></p>)}
          <div class="failure">
            <h3>{site.failure.title}</h3>
            <p><Txt text={site.failure.body} /></p>
          </div>
        </div>
        <aside class="about__stats" aria-label="My public GitHub numbers">
          <div class="stat stat--a"><b>{skyline.repos.length}</b><span>public repos of my own</span></div>
          <div class="stat stat--b"><b>{totalCommits}</b><span>commits in them</span></div>
          <div class="stat stat--c">
            <b>{tallest.commits}</b><span>commits in {tallest.name}, the tallest building in town</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="skills" id="skills" aria-labelledby="skills-title">
      <div class="wrap">
        <p class="caption">Tech superpowers</p>
        <h2 id="skills-title" class="section-title">Skills</h2>
        <p class="skills__note">No percentage bars. Each skill links to a project that used it.</p>
        <div class="skills__grid">
          {
            site.skills.map((g) => (
              <section class="fare">
                <h3>{g.group}</h3>
                <ul>
                  {g.items.map((s) => (
                    <li>
                      <span>{s.name}</span>
                      <a href={`/projects/${s.proof}/`}>{titleOf(s.proof)}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="wrap">
        <p class="caption">Case files</p>
        <h2 id="projects-title" class="section-title">Projects</h2>
        <ol class="cards">
          {
            featured.map((p, i) => (
              <li class="card">
                <p class="card__no">#{String(i + 1).padStart(2, '0')}</p>
                <h3>
                  <a href={`/projects/${p.slug}/`}>{p.title}</a>
                </h3>
                <p class="card__line">{p.oneLiner}</p>
                <ul class="tags">
                  {p.stack.slice(0, 5).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <p class="card__meta">
                  {commitsOf(p.repoName) ? `${commitsOf(p.repoName)} commits` : 'Source not public yet'}
                </p>
                <div class="card__actions">
                  <a class="btn btn--yellow" href={`/projects/${p.slug}/`}>
                    Read case file
                  </a>
                  <a class="btn" href={`#${p.slug}`} data-play={p.slug}>
                    ▶ Play mission
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
        <h3 class="more__title">More from the city</h3>
        <ul class="more">
          {
            more.map((p) => (
              <li>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
                <span>{p.oneLiner}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="city-section" id="city" aria-labelledby="city-title">
      <div class="wrap">
        <p class="caption">Why it's called Commit City</p>
        <h2 id="city-title" class="section-title">The skyline is real</h2>
        <p class="city-section__note">
          Each building is one of my public repos, oldest on the left. Each lit window is one real commit. The tallest
          tower is {tallest.commits} commits of {tallest.name}. Snapshot from {skyline.snapshotDate}.
        </p>
      </div>
      <div class="city-scroll" tabindex="0" role="region" aria-label="Skyline, scrolls sideways on small screens">
        <SkylineArt />
      </div>
      <details class="wrap city-list">
        <summary>Read the skyline as a list</summary>
        <ul>
          {
            skyline.repos.map((r) => (
              <li>
                <a href={r.url}>{r.name}</a>: {r.commits} commit{r.commits === 1 ? '' : 's'}
              </li>
            ))
          }
        </ul>
      </details>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <p class="caption">One new call</p>
        <h2 id="contact-title" class="section-title">Got a job for me?</h2>
        <ul class="contact__links">
          <li><a class="btn btn--yellow" href={contact.github}>GitHub</a></li>
          <li>
            {
              contact.email.startsWith('TODO_USER') ? (
                <Txt text={contact.email} />
              ) : (
                <a class="btn" href={`mailto:${contact.email}`}>
                  Email
                </a>
              )
            }
          </li>
          <li>
            {
              contact.linkedin.startsWith('TODO_USER') ? (
                <Txt text={contact.linkedin} />
              ) : (
                <a class="btn" href={contact.linkedin}>
                  LinkedIn
                </a>
              )
            }
          </li>
        </ul>
      </div>
    </section>
  </main>
  <footer class="foot">
    <p>Hosted on AWS Amplify. Built by {site.name} with an AI coding agent. Original art and sound.</p>
  </footer>
</Base>

<style>
  .wrap {
    width: min(100%, 1240px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  section {
    padding-block: clamp(56px, 9vw, 112px);
  }

  section.projects,
  section.about,
  section.skills,
  section.contact,
  section.city-section {
    border-top: 6px solid var(--ink);
  }

  /* About */
  .about {
    background: var(--paper);
    color: var(--ink);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 84px);
    align-items: start;
  }

  .about__text p:not(.caption) {
    max-width: 62ch;
    margin-top: 16px;
  }

  .about__text .about__lead {
    margin-top: 22px;
    font: 700 clamp(1.45rem, 3vw, 2.05rem) / 1.25 var(--hand);
  }

  .failure {
    max-width: 62ch;
    margin-top: 24px;
    padding: 14px 18px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 6px 6px 0 var(--red);
  }

  .failure h3 {
    color: var(--red);
    font-size: 1.7rem;
  }

  .about__text .failure p {
    margin-top: 6px;
  }

  .about__stats {
    display: grid;
    gap: 18px;
  }

  .stat {
    padding: 14px 18px 12px;
    border: var(--border);
    box-shadow: var(--shadow);
    background: var(--yellow);
  }

  .stat--a {
    transform: rotate(-1.4deg);
  }

  .stat--b {
    --dot: var(--yellow-deep);
    transform: rotate(0.8deg);
    background-color: var(--paper);
    background-image: radial-gradient(circle, #e6d6a8 30%, transparent 32%);
    background-size: 8px 8px;
  }

  .stat--c {
    transform: rotate(-0.6deg);
    background: var(--ink);
    color: var(--yellow);
  }

  .stat b {
    display: block;
    font: 400 clamp(3.2rem, 7vw, 5rem) / 1 var(--display);
  }

  .stat span {
    font: 500 1.28rem/1.1 var(--label);
    letter-spacing: 0.02em;
  }

  /* Skills */
  .skills {
    background-color: var(--yellow);
    background-image: radial-gradient(circle, var(--yellow-deep) 28%, transparent 30%);
    background-size: 10px 10px;
    color: var(--ink);
  }

  .skills .caption {
    background: var(--ink);
    color: var(--yellow);
  }

  .skills__note {
    margin-top: 10px;
    font: 700 1.2rem/1.3 var(--hand);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 22px;
    margin-top: 30px;
  }

  .fare {
    padding: 0;
    background: var(--paper);
    border: var(--border);
    box-shadow: var(--shadow);
  }

  .fare h3 {
    padding: 10px 14px 6px;
    background: var(--ink);
    color: var(--yellow);
    font-size: 1.5rem;
  }

  .fare ul {
    margin: 0;
    padding: 6px 14px 10px;
    list-style: none;
  }

  .fare li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 14px;
    padding: 6px 0 3px;
    border-bottom: 2px dotted #b9ab86;
    font-weight: 600;
  }

  .fare li:last-child {
    border-bottom: 0;
  }

  .fare a {
    font: 500 1.14rem/1.4 var(--label);
    letter-spacing: 0.02em;
    color: #7a2a12;
    text-underline-offset: 3px;
  }

  /* Projects */
  .projects {
    background: var(--night);
  }

  .projects .section-title {
    color: var(--yellow);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 370px), 1fr));
    gap: 30px 26px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px 20px 22px;
    background: var(--paper);
    color: var(--ink);
    border: var(--border);
    box-shadow: 9px 9px 0 var(--yellow);
    clip-path: polygon(0 0, 100% 0, 100% 96%, 96% 100%, 0 100%);
    transition: transform 0.14s steps(3);
  }

  .card:nth-child(even) {
    transform: rotate(0.7deg);
  }

  .card:nth-child(odd) {
    transform: rotate(-0.6deg);
  }

  .card:hover {
    transform: rotate(0) translateY(-5px);
  }

  .card__no {
    position: absolute;
    top: 8px;
    right: 14px;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
    font: 400 3.6rem/1 var(--display);
  }

  .card h3 {
    max-width: 78%;
    font-size: clamp(2.2rem, 4.4vw, 3rem);
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--red);
  }

  .card__line {
    margin-top: 12px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 3px 8px 0;
    background: var(--ink);
    color: var(--paper);
    font: 500 1.05rem/1.25 var(--label);
    letter-spacing: 0.02em;
  }

  .card__meta {
    margin-top: 12px;
    font: 700 1.2rem/1 var(--label);
    letter-spacing: 0.03em;
    color: #7a2a12;
    text-transform: uppercase;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }

  .more__title {
    margin-top: clamp(40px, 7vw, 72px);
    color: var(--yellow);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px 28px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    padding-top: 10px;
    border-top: 3px solid var(--yellow);
  }

  .more a {
    display: block;
    color: var(--yellow);
    font: 700 1.55rem/1.1 var(--label);
    letter-spacing: 0.02em;
    text-underline-offset: 3px;
  }

  .more span {
    font-size: 0.98rem;
  }

  /* City */
  .city-section {
    padding-bottom: 0;
    background: #0d0b08;
  }

  .city-section .section-title {
    color: var(--yellow);
  }

  .city-section__note {
    max-width: 66ch;
    margin-top: 14px;
  }

  .city-scroll {
    height: clamp(380px, 60vh, 620px);
    margin-top: 10px;
    overflow-x: auto;
    border-bottom: 6px solid var(--yellow);
  }

  .city-scroll :global(.city) {
    min-width: 760px;
  }

  .city-list {
    padding-block: 18px 34px;
    font-size: 1rem;
  }

  .city-list summary {
    cursor: pointer;
    font: 500 1.3rem/1.4 var(--label);
    color: var(--yellow);
  }

  .city-list ul {
    columns: 2 240px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  /* Contact */
  .contact {
    background: var(--red);
    color: var(--ink);
  }

  .contact .section-title {
    color: var(--paper);
    text-shadow: 4px 4px 0 var(--ink);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .foot {
    padding: 22px var(--gutter);
    background: var(--ink);
    font-size: 0.95rem;
    text-align: center;
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .card {
      transform: none !important;
    }
  }
</style>
