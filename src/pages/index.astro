---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Hud from '../components/Hud.astro';
import SkylineArt from '../components/SkylineArt.astro';
import Txt from '../components/Txt.astro';
import site from '../../content/site.json';
import projects from '../../content/projects.json';
import { skyline, totalCommits, tallest } from '../lib/skyline';

const titleOf = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
const featured = projects.filter((p) => p.mission);
const more = projects.filter((p) => !p.mission);
const commitsOf = (repo: string | null) => skyline.repos.find((r) => r.name === repo)?.commits;
const { contact } = site;
const covers = ['#ff2e88', '#17c4d6', '#ffc917', '#7a2cff', '#f03a2e'];
---

<Base>
  <div class="poster" aria-hidden="true"><i></i></div>
  <canvas class="world" data-world aria-hidden="true"></canvas>
  <Hud />

  <main id="main">
    <Hero />

    <section class="beat beat--left" id="about" data-p="0.23" aria-labelledby="about-title">
      <div class="panel panel--paper">
        <p class="caption">{site.about.caption}</p>
        <h2 id="about-title" class="section-title">About me</h2>
        <p class="about__lead">{site.about.lead}</p>
        {site.about.paragraphs.map((text) => <p class="about__p"><Txt text={text} /></p>)}
        <dl class="stats">
          <div><dt>Public repos</dt><dd>{skyline.repos.length}</dd></div>
          <div><dt>Commits</dt><dd>{totalCommits}</dd></div>
          <div><dt>Tallest tower</dt><dd>{tallest.commits}</dd></div>
        </dl>
        <div class="failure">
          <h3>{site.failure.title}</h3>
          <p><Txt text={site.failure.body} /></p>
        </div>
      </div>
    </section>

    <section class="beat beat--right" id="skills" data-p="0.42" aria-labelledby="skills-title">
      <div class="panel panel--ink">
        <p class="caption">Tech superpowers</p>
        <h2 id="skills-title" class="section-title">Skills</h2>
        <p class="skills__note">No percentage bars. Each skill links to a project that used it.</p>
        <div class="skills__grid">
          {
            site.skills.map((g) => (
              <section class="fare">
                <h3>{g.group}</h3>
                <ul>
                  {g.items.map((s) => (
                    <li>
                      <span>{s.name}</span>
                      <a href={`/projects/${s.proof}/`}>{titleOf(s.proof)}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <section class="street" id="projects" data-p="0.56" aria-labelledby="projects-title">
      <header class="street__head">
        <p class="caption">Case files</p>
        <h2 id="projects-title" class="section-title">Projects</h2>
      </header>
      <ol class="cards">
        {
          featured.map((p, i) => (
            <li class="card" style={`--c:${covers[i % covers.length]}`}>
              <p class="card__no">#{String(i + 1).padStart(2, '0')}</p>
              <p class="card__place">{p.district}</p>
              <h3>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
              </h3>
              <div class="card__body">
                <p>{p.oneLiner}</p>
                <ul class="tags">
                  {p.stack.slice(0, 5).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <p class="card__meta">
                  {commitsOf(p.repoName) ? `${commitsOf(p.repoName)} commits` : 'Source not public yet'}
                </p>
                <div class="card__actions">
                  <a class="btn btn--yellow" href={`#${p.slug}`} data-play={p.slug}>
                    ▶ Play mission
                  </a>
                  <a class="btn" href={`/projects/${p.slug}/`}>
                    Case file
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="panel panel--ink more-panel">
        <h3 class="more__title">More from the city</h3>
        <ul class="more">
          {
            more.map((p) => (
              <li>
                <a href={`/projects/${p.slug}/`}>{p.title}</a>
                <span>{p.oneLiner}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="beat beat--wide" id="city" data-p="0.9" aria-labelledby="city-title">
      <div class="panel panel--ink">
        <p class="caption">Why it's called Commit City</p>
        <h2 id="city-title" class="section-title">The skyline is real</h2>
        <p>
          The gold towers out there are my real public repos: the more commits, the taller the tower. Down here is the
          exact count, with one lit window for every commit, oldest repo on the left. Snapshot from {skyline.snapshotDate}.
        </p>
        <div class="city-scroll" tabindex="0" role="region" aria-label="Skyline, scrolls sideways on small screens">
          <SkylineArt />
        </div>
        <details class="city-list">
          <summary>Read the skyline as a list</summary>
          <ul>
            {
              skyline.repos.map((r) => (
                <li>
                  <a href={r.url}>{r.name}</a>: {r.commits} commit{r.commits === 1 ? '' : 's'}
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </section>

    <section class="beat beat--left contact" id="contact" data-p="1" aria-labelledby="contact-title">
      <div class="panel panel--pink">
        <p class="caption">One new call</p>
        <h2 id="contact-title" class="section-title">Got a job for me?</h2>
        <ul class="contact__links">
          <li><a class="btn btn--yellow" href={contact.github}>GitHub</a></li>
          <li>
            {
              contact.email.startsWith('TODO_USER') ? (
                <Txt text={contact.email} />
              ) : (
                <a class="btn" href={`mailto:${contact.email}`}>
                  Email
                </a>
              )
            }
          </li>
          <li>
            {
              contact.linkedin.startsWith('TODO_USER') ? (
                <Txt text={contact.linkedin} />
              ) : (
                <a class="btn" href={contact.linkedin}>
                  LinkedIn
                </a>
              )
            }
          </li>
        </ul>
        <p class="foot">Hosted on AWS Amplify. Built by {site.name} with an AI coding agent. Original art and sound.</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../world/boot';
</script>

<style>
  /* Painted stand-in: visible until the 3D city is ready, and the whole background if it never is. */
  .poster {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: linear-gradient(#120733 0, #5f0f9e 34%, #fb1778 62%, #ff6b22 78%, #2a0f5e 78.2%, #14082f 100%);
  }

  .poster i {
    position: absolute;
    left: 50%;
    bottom: 22%;
    width: min(62vw, 66vh);
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(#ffdb1c, #ff4e52);
    transform: translate(-40%, 42%);
  }

  .world {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .world:global(.is-on) {
    opacity: 1;
  }

  main {
    position: relative;
    z-index: 1;
  }

  /* Each beat is a stretch of the fall, with a comic panel floating over the moving city. */
  .beat {
    display: flex;
    align-items: center;
    min-height: 165svh;
    padding: 18svh var(--gutter);
  }

  .beat--right {
    justify-content: flex-end;
  }

  .beat--wide {
    justify-content: center;
  }

  .panel {
    width: min(100%, 640px);
    padding: clamp(18px, 3vw, 34px);
    border: 5px solid var(--ink);
    box-shadow:
      9px 9px 0 var(--pink),
      18px 18px 0 var(--ink);
    transform: rotate(-1.2deg);
  }

  .beat--right .panel {
    width: min(100%, 780px);
    transform: rotate(1deg);
    box-shadow:
      -9px 9px 0 var(--cyan),
      -18px 18px 0 var(--ink);
  }

  .beat--wide .panel {
    width: min(100%, 1180px);
    transform: rotate(-0.5deg);
  }

  .panel--paper {
    background: var(--paper);
    color: var(--ink);
  }

  .panel--ink {
    background: #0f0820;
    color: var(--paper);
  }

  .panel--ink .section-title {
    color: var(--yellow);
  }

  .panel--pink {
    background: var(--pink);
    color: var(--ink);
  }

  .panel--pink .section-title {
    color: var(--paper);
    text-shadow: 4px 4px 0 var(--ink);
  }

  .about__lead {
    margin-top: 16px;
    font: 700 clamp(1.4rem, 2.6vw, 1.9rem) / 1.22 var(--hand);
  }

  .about__p {
    margin-top: 12px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 20px 0 0;
  }

  .stats div {
    padding: 8px 10px 4px;
    background: var(--yellow);
    border: 3px solid var(--ink);
  }

  .stats div:nth-child(2) {
    background: var(--cyan);
  }

  .stats div:nth-child(3) {
    background: var(--ink);
    color: var(--paper);
  }

  .stats dt {
    font: 500 1.02rem/1 var(--label);
  }

  .stats dd {
    margin: 0;
    font: 400 clamp(2rem, 4vw, 3rem) / 1.1 var(--display);
  }

  .failure {
    margin-top: 18px;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--paper);
  }

  .failure h3 {
    color: var(--red);
    font-size: 1.5rem;
  }

  .failure p {
    margin-top: 6px;
  }

  .skills__note {
    margin-top: 8px;
    font: 700 1.15rem/1.3 var(--hand);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .fare {
    border: 3px solid var(--yellow);
  }

  .fare h3 {
    padding: 8px 10px 4px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 1.3rem;
  }

  .fare:nth-child(2) {
    border-color: var(--cyan);
  }

  .fare:nth-child(2) h3 {
    background: var(--cyan);
  }

  .fare:nth-child(3) {
    border-color: var(--pink);
  }

  .fare:nth-child(3) h3 {
    background: var(--pink);
  }

  .fare ul {
    margin: 0;
    padding: 4px 10px 6px;
    list-style: none;
  }

  .fare li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 12px;
    padding: 4px 0 2px;
    border-bottom: 1px solid #3a2a60;
    font-size: 0.96rem;
    font-weight: 600;
  }

  .fare li:last-child {
    border-bottom: 0;
  }

  .fare a {
    color: var(--yellow);
    font: 500 1.08rem/1.35 var(--label);
    text-underline-offset: 3px;
  }

  /* Street chase: covers fly past on alternating sides, with the road visible between them. */
  .street {
    padding: 30svh var(--gutter) 40svh;
  }

  .street__head {
    width: fit-content;
    transform: rotate(-2deg);
  }

  .street__head .section-title {
    color: var(--yellow);
    -webkit-text-stroke: 3px var(--ink);
    paint-order: stroke fill;
    text-shadow: 6px 6px 0 var(--ink);
    font-size: clamp(4rem, 13vw, 10rem);
    font-family: var(--poster);
  }

  .cards {
    display: grid;
    gap: 58svh;
    margin: 40svh 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    width: min(100%, 620px);
    background: var(--c);
    border: 5px solid var(--ink);
    box-shadow: 12px 12px 0 var(--ink);
    transform: rotate(-1.6deg);
    transition: transform 0.12s steps(2);
  }

  .card:nth-child(even) {
    justify-self: end;
    transform: rotate(1.6deg);
  }

  .card:hover {
    transform: rotate(0) scale(1.015);
  }

  .card__no {
    position: absolute;
    top: -30px;
    right: 12px;
    color: var(--paper);
    -webkit-text-stroke: 3px var(--ink);
    paint-order: stroke fill;
    font: 400 4.2rem/1 var(--poster);
  }

  .card__place {
    padding: 14px 20px 0;
    font: 700 1.3rem/1 var(--label);
    color: var(--ink);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card h3 {
    padding: 2px 20px 12px;
    font-family: var(--poster);
    font-size: clamp(2.5rem, 6.4vw, 4.4rem);
    line-height: 0.95;
    color: var(--ink);
  }

  .card h3 a {
    text-decoration: none;
  }

  .card__body {
    padding: 16px 20px 20px;
    background: var(--paper);
    color: var(--ink);
    border-top: 5px solid var(--ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 3px 8px 0;
    background: var(--ink);
    color: var(--paper);
    font: 500 1.05rem/1.25 var(--label);
  }

  .card__meta {
    margin-top: 10px;
    font: 700 1.2rem/1 var(--label);
    color: #8a1456;
    text-transform: uppercase;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .more-panel {
    width: min(100%, 980px);
    margin: 58svh auto 0;
  }

  .more__title {
    color: var(--yellow);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 14px 22px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    padding-top: 8px;
    border-top: 3px solid var(--pink);
  }

  .more a {
    display: block;
    color: var(--yellow);
    font: 700 1.5rem/1.1 var(--label);
    text-underline-offset: 3px;
  }

  .more span {
    font-size: 0.95rem;
  }

  .city-scroll {
    margin-top: 14px;
    overflow-x: auto;
    background: #05030c;
    border-bottom: 5px solid var(--yellow);
  }

  .city-scroll :global(.city) {
    min-width: 1040px;
    height: auto;
  }

  .city-list {
    margin-top: 12px;
    font-size: 0.98rem;
  }

  .city-list summary {
    cursor: pointer;
    color: var(--yellow);
    font: 500 1.3rem/1.4 var(--label);
  }

  .city-list ul {
    columns: 2 240px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact {
    min-height: 120svh;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .foot {
    margin-top: 22px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .beat {
      min-height: 150svh;
      padding: 14svh 14px;
    }

    .panel {
      box-shadow:
        5px 5px 0 var(--pink),
        10px 10px 0 var(--ink);
    }

    .beat--right .panel {
      box-shadow:
        -5px 5px 0 var(--cyan),
        -10px 10px 0 var(--ink);
    }

    .street {
      padding-inline: 14px;
    }

    .cards {
      gap: 44svh;
    }
  }
</style>
