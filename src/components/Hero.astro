---
import site from '../../content/site.json';
---

<section class="hero" id="top" data-p="0" aria-labelledby="hero-title">
  <div class="hero__stack">
    <p class="hero__issue"><span>Issue #01</span> A playable comic</p>
    <h1 id="hero-title" class="title">
      <span class="title__line" data-t="COMMIT">COMMIT</span>
      <span class="title__line title__line--2" data-t="CITY">CITY</span>
    </h1>
    <p class="hero__tag">{site.shortName} <span>Kommana</span></p>
    <p class="hero__sub">Student developer. Builder of games, AI tools and very questionable side projects.</p>
    <div class="hero__cta">
      <a class="play" href="#about" data-play>
        <span class="play__tri" aria-hidden="true">▶</span>
        <span class="play__txt">Play my story<small>3 minutes, works on your phone</small></span>
      </a>
    </div>
  </div>

  <a class="jump" href="#about">
    <b>Scroll to jump</b>
    <i aria-hidden="true">▼</i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 118svh;
    padding: clamp(14px, 3vh, 32px) var(--gutter) 0;
  }

  .hero__stack {
    width: min(100%, 700px);
  }

  .hero__issue {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 3px 12px 0 0;
    background: var(--paper);
    color: var(--ink);
    font: 700 clamp(1.05rem, 2.1vw, 1.35rem) / 1.2 var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-1.6deg);
  }

  .hero__issue span {
    margin-block: -3px 0;
    padding: 3px 10px 0;
    background: var(--pink);
    color: var(--paper);
  }

  .title {
    margin: 8px 0 0 -4px;
    font-family: var(--poster);
    font-size: clamp(4.2rem, min(10.8vw, 21vh), 13rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    transform: skewY(-3deg) rotate(-1deg);
    transform-origin: left;
  }

  .title__line {
    position: relative;
    display: block;
    width: fit-content;
    color: var(--yellow);
    -webkit-text-stroke: clamp(2px, 0.5vw, 5px) var(--ink);
    paint-order: stroke fill;
    text-shadow: 0.055em 0.055em 0 var(--ink);
    animation: boil 0.5s steps(1) infinite;
  }

  .title__line--2 {
    margin-left: 0.5em;
    color: var(--paper);
  }

  /* Cut slices of the word in off-register colour, slipping on twos like a misprint. */
  .title__line::before,
  .title__line::after {
    content: attr(data-t);
    position: absolute;
    inset: 0;
    -webkit-text-stroke: 0;
    text-shadow: none;
    pointer-events: none;
  }

  .title__line::before {
    color: inherit;
    text-shadow: -4px 0 0 var(--cyan);
    clip-path: polygon(0 34%, 100% 34%, 100% 46%, 0 46%);
    animation: slip-a 1.7s steps(1) infinite;
  }

  .title__line::after {
    color: inherit;
    text-shadow: 4px 0 0 var(--pink);
    clip-path: polygon(0 68%, 100% 68%, 100% 76%, 0 76%);
    animation: slip-b 1.3s steps(1) infinite;
  }

  .hero__tag {
    margin-top: -0.2em;
    margin-left: min(13vw, 150px);
    color: var(--pink);
    font: 400 clamp(2.3rem, 5.4vw, 4.2rem) / 1 var(--tag);
    text-shadow:
      3px 3px 0 var(--ink),
      -2px -1px 0 var(--ink);
    transform: rotate(-6deg);
    position: relative;
    white-space: nowrap;
  }

  .hero__tag span {
    color: var(--paper);
  }

  .hero__sub {
    width: fit-content;
    max-width: 30em;
    margin-top: clamp(4px, 1vh, 12px);
    padding: 7px 12px 5px;
    background: var(--ink);
    color: var(--paper);
    font: 600 clamp(0.98rem, 1.6vw, 1.12rem) / 1.3 var(--body);
    transform: rotate(-0.8deg);
  }

  .hero__cta {
    margin-top: clamp(12px, 2.4vh, 24px);
  }

  .play {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 24px 7px 14px;
    background: var(--yellow);
    color: var(--ink);
    border: 5px solid var(--ink);
    font: 400 clamp(1.9rem, 4.6vw, 3rem) / 1 var(--display);
    text-decoration: none;
    text-transform: uppercase;
    box-shadow:
      7px 7px 0 var(--pink),
      14px 14px 0 var(--ink);
    transform: rotate(-2deg);
    transition:
      transform 0.1s steps(2),
      box-shadow 0.1s steps(2);
  }

  .play:hover {
    transform: rotate(0) translate(-4px, -4px) scale(1.03);
    box-shadow:
      10px 10px 0 var(--cyan),
      20px 20px 0 var(--ink);
  }

  .play:active {
    transform: translate(5px, 5px);
    box-shadow: 2px 2px 0 var(--pink);
  }

  .play__tri {
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    padding-left: 0.1em;
    background: var(--ink);
    color: var(--yellow);
    font-size: 0.8em;
    border-radius: 50%;
  }

  .play__txt small {
    display: block;
    margin-top: 2px;
    font: 500 clamp(1rem, 1.9vw, 1.2rem) / 1 var(--label);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .jump {
    position: absolute;
    right: 36%;
    top: calc(100svh - var(--nav-h) - 158px);
    display: grid;
    justify-items: center;
    color: var(--ink);
    text-decoration: none;
    transform: rotate(4deg);
  }

  .jump b {
    padding: 8px 16px 5px;
    background: var(--paper);
    border: 4px solid var(--ink);
    border-radius: 50% 46% 48% 52% / 58% 52% 58% 50%;
    font: 700 clamp(1.1rem, 2vw, 1.5rem) / 1 var(--hand);
  }

  .jump i {
    margin-top: 2px;
    color: var(--yellow);
    font-style: normal;
    font-size: 1.8rem;
    text-shadow: 0 0 0 var(--ink), 2px 2px 0 var(--ink);
    animation: hop 0.66s steps(2) infinite alternate;
  }

  @keyframes hop {
    to {
      translate: 0 9px;
    }
  }

  @keyframes boil {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0.5px -0.5px;
    }
  }

  @keyframes slip-a {
    0%,
    100% {
      translate: -5px 1px;
    }
    23% {
      translate: 9px -2px;
    }
    47% {
      translate: -3px 2px;
    }
    73% {
      translate: 5px 0;
    }
  }

  @keyframes slip-b {
    0%,
    100% {
      translate: 5px -1px;
    }
    31% {
      translate: -8px 2px;
    }
    64% {
      translate: 3px -2px;
    }
  }

  @media (max-width: 760px) {
    .title {
      font-size: min(19vw, 14vh);
    }

    .hero__tag {
      margin-left: 6vw;
    }

    .hero__stack {
      width: 100%;
    }

    .jump {
      right: 8%;
      top: calc(100svh - var(--nav-h) - 110px);
    }
  }

  @media (max-height: 640px) and (min-width: 761px) {
    .hero__sub {
      display: none;
    }
  }
</style>
