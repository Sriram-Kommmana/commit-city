---
import site from '../../content/site.json';
const w = site.notes;
---

<section class="wall" id="notes" data-p="1" aria-labelledby="notes-title" data-api={w.api}>
  <div class="wall__panel">
    <p class="caption">{w.caption}</p>
    <h2 id="notes-title" class="section-title">{w.title}</h2>
    <p class="wall__lead">{w.lead}</p>

    <form class="wall__form" novalidate>
      <label class="wall__msg">
        <span class="visually-hidden">Your note</span>
        <textarea name="msg" maxlength="240" rows="3" placeholder={w.placeholder} required></textarea>
        <small aria-live="polite" data-count>0 / 240</small>
      </label>
      <div class="wall__row">
        <label class="wall__name">
          <span>Your name</span>
          <input name="name" maxlength="32" autocomplete="nickname" placeholder="Optional" />
        </label>
        <fieldset class="wall__colors">
          <legend>Sticky note</legend>
          {
            ['yellow', 'pink', 'cyan', 'green'].map((c, i) => (
              <label class={`swatch swatch--${c}`}>
                <input type="radio" name="color" value={c} checked={i === 0} />
                <span class="visually-hidden">{c}</span>
              </label>
            ))
          }
        </fieldset>
        <!-- Hidden from people, filled in by bots. -->
        <label class="wall__trap" aria-hidden="true">
          Website <input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <button class="btn btn--yellow" type="submit">{w.submit}</button>
      </div>
      <p class="wall__status" role="status" data-status></p>
    </form>

    <ul class="notes" data-notes aria-label="Notes left by visitors"></ul>
    <p class="wall__empty" data-empty hidden>{w.empty}</p>
  </div>
</section>

<script>
  type Note = { id: string; name: string; msg: string; color: string; at: number };

  const section = document.querySelector<HTMLElement>('#notes');
  const api = section?.dataset.api ?? '';
  const form = section?.querySelector<HTMLFormElement>('.wall__form');
  const list = section?.querySelector<HTMLUListElement>('[data-notes]');
  const empty = section?.querySelector<HTMLElement>('[data-empty]');
  const status = section?.querySelector<HTMLElement>('[data-status]');
  const count = section?.querySelector<HTMLElement>('[data-count]');

  const ago = (at: number) => {
    const s = Math.max(1, Math.round((Date.now() - at) / 1000));
    if (s < 60) return 'just now';
    const m = Math.round(s / 60);
    if (m < 60) return `${m} min ago`;
    const h = Math.round(m / 60);
    if (h < 24) return `${h} h ago`;
    const d = Math.round(h / 24);
    return d < 30 ? `${d} d ago` : new Date(at).toLocaleDateString();
  };

  // Built with textContent only, so nothing anyone writes can become HTML.
  const card = (n: Note, fresh = false) => {
    const li = document.createElement('li');
    li.className = `note note--${n.color}${fresh ? ' is-fresh' : ''}`;
    li.style.setProperty('--tilt', `${((n.at % 7) - 3) * 0.8}deg`);
    const p = document.createElement('p');
    p.textContent = n.msg;
    const by = document.createElement('small');
    by.textContent = `— ${n.name} · ${ago(n.at)}`;
    li.append(p, by);
    return li;
  };

  const show = (notes: Note[]) => {
    if (!list || !empty) return;
    list.replaceChildren(...notes.map((n) => card(n)));
    empty.hidden = notes.length > 0;
  };

  const say = (text: string, bad = false) => {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle('is-bad', bad);
  };

  const load = async () => {
    if (!api) {
      say('The wall opens once the site is live.');
      if (empty) empty.hidden = false;
      return;
    }
    try {
      const r = await fetch(api);
      if (!r.ok) throw new Error(String(r.status));
      show(((await r.json()) as { notes: Note[] }).notes);
    } catch {
      say('The wall is having a moment. Try again later.', true);
    }
  };

  // Loads when the wall comes close, so the page never waits on it.
  if (section) {
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        seen.disconnect();
        load();
      }
    }, { rootMargin: '600px' });
    seen.observe(section);
  }

  form?.querySelector('textarea')?.addEventListener('input', (e) => {
    if (count) count.textContent = `${(e.target as HTMLTextAreaElement).value.length} / 240`;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const msg = String(data.get('msg') ?? '').trim();
    if (msg.length < 2) return say('Write a note first.', true);
    if (!api) return say('The wall opens once the site is live.', true);
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    say('Sticking it on...');
    try {
      const r = await fetch(api, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ msg, name: data.get('name'), color: data.get('color'), website: data.get('website') }),
      });
      const body = (await r.json().catch(() => ({}))) as { note?: Note; error?: string };
      if (!r.ok) throw new Error(body.error ?? 'Something went wrong. Try again.');
      if (body.note && list && empty) {
        list.prepend(card(body.note, true));
        empty.hidden = true;
      }
      form.reset();
      if (count) count.textContent = '0 / 240';
      say('Stuck! Thanks for the note.');
      window.dispatchEvent(new Event('world:cut'));
    } catch (err) {
      say((err as Error).message || 'Something went wrong. Try again.', true);
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .wall {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120svh;
    padding: 18svh var(--gutter);
  }

  .wall__panel {
    width: min(100%, 1040px);
    padding: clamp(18px, 3vw, 34px);
    color: var(--ink);
    border: 5px solid var(--ink);
    box-shadow:
      9px 9px 0 var(--yellow),
      18px 18px 0 var(--ink);
    transform: rotate(0.8deg);
    background:
      radial-gradient(circle, rgb(7 4 14 / 0.07) 1.5px, transparent 2px) 0 0 / 12px 12px,
      var(--paper);
  }

  .wall__lead {
    margin-top: 8px;
    font: 700 clamp(1.05rem, 2.2vw, 1.35rem) / 1.3 var(--hand);
  }

  .wall__form {
    margin-top: 18px;
  }

  .wall__msg {
    position: relative;
    display: block;
  }

  .wall__msg textarea {
    display: block;
    width: 100%;
    padding: 12px 14px 26px;
    background: #fffbea;
    color: var(--ink);
    border: 4px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    font: 600 1.15rem / 1.35 var(--hand);
    resize: vertical;
  }

  .wall__msg small {
    position: absolute;
    right: 12px;
    bottom: 6px;
    font: 600 0.9rem/1 var(--label);
    opacity: 0.7;
  }

  .wall__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 18px;
    margin-top: 14px;
  }

  .wall__name {
    display: grid;
    gap: 3px;
    font: 600 1rem/1 var(--label);
    text-transform: uppercase;
  }

  .wall__name input {
    width: 200px;
    max-width: 100%;
    padding: 7px 10px;
    border: 3px solid var(--ink);
    font: 500 1rem/1.2 var(--body);
  }

  .wall__colors {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .wall__colors legend {
    float: left;
    width: 100%;
    margin-bottom: 3px;
    font: 600 1rem/1 var(--label);
    text-transform: uppercase;
  }

  .swatch {
    display: block;
    width: 34px;
    height: 34px;
    border: 3px solid var(--ink);
    cursor: pointer;
  }

  .swatch input {
    position: absolute;
    opacity: 0;
  }

  .swatch:has(input:checked) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    transform: rotate(-6deg);
  }

  .swatch:has(input:focus-visible) {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }

  .swatch--yellow,
  .notes :global(.note--yellow) {
    background: #ffe76a;
  }

  .swatch--pink,
  .notes :global(.note--pink) {
    background: #ff9cc8;
  }

  .swatch--cyan,
  .notes :global(.note--cyan) {
    background: #8deeff;
  }

  .swatch--green,
  .notes :global(.note--green) {
    background: #b6ff8f;
  }

  .wall__trap {
    position: absolute;
    left: -9999px;
  }

  .wall__row .btn {
    margin-left: auto;
  }

  .wall__status {
    min-height: 1.4em;
    margin-top: 10px;
    font: 700 1.05rem/1.3 var(--hand);
  }

  .wall__status.is-bad {
    color: #c4135f;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 18px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .notes :global(.note) {
    position: relative;
    padding: 18px 14px 12px;
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(var(--tilt, 0deg));
    overflow-wrap: anywhere;
  }

  /* A strip of tape on top. */
  .notes :global(.note)::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 64px;
    height: 16px;
    background: rgb(255 255 255 / 0.65);
    border: 2px solid rgb(7 4 14 / 0.35);
    transform: translateX(-50%) rotate(-3deg);
  }

  .notes :global(.note p) {
    font: 700 1.08rem/1.3 var(--hand);
  }

  .notes :global(.note small) {
    display: block;
    margin-top: 10px;
    font: 600 0.92rem/1.2 var(--label);
    opacity: 0.8;
  }

  .notes :global(.note.is-fresh) {
    animation: stick 0.3s steps(4);
  }

  @keyframes stick {
    from {
      transform: scale(1.4) rotate(8deg);
    }
  }

  .wall__empty {
    margin-top: 14px;
    font: 700 1.1rem/1.3 var(--hand);
    opacity: 0.75;
  }
</style>
