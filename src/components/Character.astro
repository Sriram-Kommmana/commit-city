---
// The character: an ink figure whose pupils follow the pointer. The art is shared with story mode.
import svg from '../art/character.svg?raw';
---

<Fragment set:html={svg} />

<script>
  // Pupils follow the pointer in small steps, so it reads as drawn animation.
  const eyes = document.querySelector<SVGGElement>('[data-eyes]');
  if (eyes && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    addEventListener(
      'pointermove',
      (e) => {
        const box = eyes.getBoundingClientRect();
        const dx = e.clientX - (box.left + box.width / 2);
        const dy = e.clientY - (box.top + box.height / 2);
        const len = Math.hypot(dx, dy) || 1;
        const x = Math.round((dx / len) * 2) * 2;
        const y = Math.round((dy / len) * 2) * 1.5;
        eyes.setAttribute('transform', `translate(${x} ${y})`);
      },
      { passive: true },
    );
  }
</script>
